# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG PHÂN HỆ AI (AI_SERVICE ENVIRONMENT CONFIGURATION)
# ==============================================================================
# Sao chép tệp này thành .env để áp dụng cấu hình tùy chỉnh cho dịch vụ:
# cp .env.example .env
# ==============================================================================

# 1. BẢO MẬT & XÁC THỰC NỘI BỘ (Security & Internal Authentication)
# Khóa bí mật bắt buộc truyền qua Header 'X-Internal-Key' hoặc query param 'api_key'
# CẢNH BÁO: Phải thay đổi khóa này khi triển khai lên môi trường Production!
AI_INTERNAL_KEY=dev-internal-secret-key-change-in-prod

# 2. KIỂM DUYỆT CƠ SỞ TRI THỨC Y TẾ (Clinical Knowledge Base Review Mode)
# - false (Mặc định cho Dev/Demo): Chấp nhận các bản ghi chưa qua thẩm định y khoa
# - true (Dành cho Production): Bắt buộc chỉ sử dụng các bản ghi có reviewed=true
KB_REQUIRE_REVIEWED=false

# 3. NGƯỠNG ĐỘ TƯƠNG ĐỒNG TRÍCH XUẤT TRIỆU CHỨNG (NLP Fuzzy Matching Threshold)
# Ngưỡng tỉ lệ khớp tương đối (0 - 100) dùng cho thuật toán RapidFuzz trích xuất triệu chứng
FUZZY_THRESHOLD=90

# 4. CẤU HÌNH NHẬT KÝ HỆ THỐNG (Structured Logging Level)
# Các mức hợp lệ: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 5. CẤU HÌNH MẠNG & CỔNG DỊCH VỤ (Server Network & Port)
HOST=0.0.0.0
PORT=8000
