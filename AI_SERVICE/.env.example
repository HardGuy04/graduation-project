# AI_SERVICE Environment Configuration

# Authentication key required in X-Internal-Key header for internal endpoints
AI_INTERNAL_KEY=dev-internal-secret-key-change-in-prod

# Knowledge base safety flag: if true, reject records with reviewed=false
KB_REQUIRE_REVIEWED=false

# RapidFuzz similarity threshold (0-100) for symptom extraction
FUZZY_THRESHOLD=90

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Service host & port
HOST=0.0.0.0
PORT=8000
