# ──────────────── Server ────────────────
PORT=5000
NODE_ENV=development

# ──────────────── MySQL ────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=clinic_user
DB_PASSWORD=your_mysql_password
DB_NAME=clinic

# ──────────────── Auth ────────────────
JWT_SECRET=your_long_random_jwt_secret_string_min_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ──────────────── CORS ────────────────
CORS_ORIGIN=http://localhost:5173

# ──────────────── Phòng khám ────────────────
CLINIC_UTC_OFFSET=+07:00
REMINDER_ENABLED=true

# ──────────────── AI Service ────────────────
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_KEY=your_internal_secret_key

# ──────────────── Frontend + VNPay ────────────────
FRONTEND_URL=http://localhost:5173
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
