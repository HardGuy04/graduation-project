# ──────────────── Server ────────────────
PORT=5000
NODE_ENV=development

# ──────────────── MySQL ────────────────
# Dùng user ứng dụng chỉ có quyền SELECT/INSERT/UPDATE/DELETE, KHÔNG dùng root
DB_HOST=localhost
DB_PORT=3306
DB_USER=clinic_app
DB_PASSWORD=your_password
DB_NAME=clinic

# ──────────────── Auth ────────────────
# Chuỗi ngẫu nhiên >= 32 ký tự, ví dụ: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
# Access token sống ngắn; refresh token là chuỗi ngẫu nhiên lưu SHA-256 trong DB
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ──────────────── CORS ────────────────
# Nhiều origin phân tách bằng dấu phẩy
CORS_ORIGIN=http://localhost:5173

# ──────────────── Phòng khám ────────────────
# Múi giờ của giờ làm việc trong doctor_schedule (DB lưu DATETIME theo UTC)
CLINIC_UTC_OFFSET=+07:00
# Job tạo thông báo nhắc lịch (đặt false để tắt)
REMINDER_ENABLED=true
# Quá giờ hẹn N phút: lịch chưa duyệt tự hủy, lịch đã duyệt chưa check-in tự ghi "không đến". 0 = tắt.
APPT_AUTO_CLOSE_MINUTES=30

# Ảnh đại diện lưu tại backend/<UPLOAD_DIR>/avatars; API_PUBLIC_URL là địa chỉ trình duyệt dùng để tải ảnh.
UPLOAD_DIR=uploads
API_PUBLIC_URL=http://localhost:5000

# ──────────────── Frontend + VNPay ────────────────
FRONTEND_URL=http://localhost:5173
# Để trống = nạp ví mô phỏng, tắt thanh toán hóa đơn qua VNPay.
# Bật VNPay: đăng ký sandbox tại https://sandbox.vnpayment.vn/devreg/ (mã gửi qua email),
# chạy migration 003 rồi 004 bằng root, điền 2 khóa dưới đây rồi khởi động lại backend.
# IPN URL khai báo trên merchant portal: https://<domain-public>/api/payments/vnpay/ipn (localhost không nhận được IPN).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
